# Copy this file to .env and fill it in. NEVER upload or share your real .env (it holds your bot token).
DISCORD_TOKEN=
CLIENT_ID=

# Optional
# BOT_STATUS=dnd              # dnd | online | idle | invisible (also in config/yuna.config.js)
# DEFAULT_PREFIX=yuna
# DATA_DIR=./data             # where love.json is saved (use a Railway Volume path like /data)
# YUNA_CONFIG=./config/yuna.config.js
# DISCORD_PUBLIC_KEY=         # live install counter (see README)
# TRUSTED_BOT_IDS=
# EMOJI_SYNC=off              # never upload custom emojis
# DEBUG_PREFIX=1              # log every message the prefix handler sees
